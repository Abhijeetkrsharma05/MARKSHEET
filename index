<!DOCTYPE html>
<html lang="hi"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Red Rose Public School – Report Card Generator</title>
<link href="https://fonts.googleapis.com/css2?family=Merriweather:wght@700;900&family=Source+Sans+3:wght@400;600;700&display=swap" rel="stylesheet">
<style>
:root{--bg:#f3f1ee;--ink:#1d2433;--red:#a3122a;--navy:#1b3a6b;--panel:#fff;--mut:#5b6475;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media (prefers-color-scheme:dark){:root:not([data-theme=light]){--bg:#171a21;--ink:#e8ebf2;--panel:#222733;--mut:#9aa3b5;--navy:#4b78c4}}
:root[data-theme=dark]{--bg:#171a21;--ink:#e8ebf2;--panel:#222733;--mut:#9aa3b5;--navy:#4b78c4}
*{box-sizing:border-box}html{scroll-padding-top:env(safe-area-inset-top,0px)}
body{margin:0;background:var(--bg);color:var(--ink);font-family:'Source Sans 3',system-ui,sans-serif}
.top{display:flex;gap:8px;align-items:center;padding:10px 16px;background:var(--panel);border-bottom:1px solid rgba(128,128,128,.25);flex-wrap:wrap}
.top b{font:900 17px 'Merriweather',serif;color:var(--red);margin-right:auto}
.top button{background:transparent;color:var(--ink);border-color:transparent}
.top button.on{border-color:var(--navy);color:var(--navy)}
main{max-width:1000px;margin:0 auto;padding:16px}
.panel{background:var(--panel);border-radius:10px;padding:18px;border:1px solid rgba(128,128,128,.25)}
h1{font:900 20px 'Merriweather',serif;margin:0 0 4px}
h2{font:700 15px 'Source Sans 3';margin:18px 0 6px}
p.s{margin:0 0 8px;color:var(--mut);font-size:14px}
label{display:block;font-size:12px;color:var(--mut);margin:6px 0 2px}
input,select,textarea{width:100%;padding:8px;border:1px solid rgba(128,128,128,.4);border-radius:6px;background:var(--bg);color:var(--ink);font:inherit;font-size:14px}
.g2{display:grid;grid-template-columns:1fr 1fr;gap:8px 12px}.g3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:8px 12px}
@media(max-width:600px){.g3{grid-template-columns:1fr 1fr}}
.sub{display:grid;grid-template-columns:1fr 80px 80px;gap:6px;margin-bottom:5px}
.btns{display:flex;gap:8px;flex-wrap:wrap;margin-top:16px;align-items:center}
button{padding:9px 14px;border-radius:6px;border:1px solid var(--navy);background:var(--navy);color:#fff;font:600 14px inherit;cursor:pointer}
button.o{background:transparent;color:var(--ink);border-color:rgba(128,128,128,.5)}
button.d{background:transparent;color:#c0262d;border-color:#c0262d}
button:focus-visible,input:focus-visible,select:focus-visible,textarea:focus-visible{outline:2px solid var(--red);outline-offset:2px}
.err{color:#c0262d;font-size:14px}
.wrap{overflow-x:auto;padding-bottom:8px}
.row{display:grid;grid-template-columns:1fr auto;gap:10px;align-items:center;padding:10px 0;border-bottom:1px solid rgba(128,128,128,.25)}
.row small{color:var(--mut);display:block}
.hide{display:none!important}
/* CARD */
#card{width:794px;margin:12px auto;background:#fff;color:#1a2238;border:3px solid #a3122a;padding:14px 22px;height:1123px;display:flex;flex-direction:column;overflow:hidden;font-family:'Source Sans 3',sans-serif}
#card *{color:inherit}#card>*{flex-shrink:0}
.hd{display:flex;align-items:center;gap:16px;border-bottom:1.5px solid #a3122a;padding-bottom:6px}
.hd img{width:116px;height:106px;object-fit:contain;mix-blend-mode:multiply}
.hd .t{flex:1;text-align:center}
.hd h3{margin:0;font:900 36px 'Merriweather',serif;color:#a3122a!important}
.hd .a{font:700 21px 'Merriweather',serif;margin-top:3px;color:#1b2a52}
.hd .m{font-style:italic;font-size:16px;color:#1b3a6b}
.rc{width:320px;margin:6px auto 2px;text-align:center;border:2px solid #1b3a6b;border-radius:18px;background:#dbe9fa;font:900 28px 'Merriweather',serif;padding:3px;color:#12295a}
.ss{text-align:center;font-weight:700;font-size:17px;line-height:1.4;color:#12295a}
.box{border:1.5px solid #1b3a6b;border-radius:10px;margin-top:6px;overflow:hidden}
.info{display:grid;grid-template-columns:1fr 1fr;background:#eef5fd;padding:6px 4px}
.info .r{display:grid;grid-template-columns:125px 12px 1fr;font-size:14.5px;padding:1px 8px}
.bar{text-align:center;font:700 18px 'Source Sans 3';padding:5px;color:#12295a}
.sc .bar{background:#fbdde2}.co .bar{background:#d8efd2;font-size:16px;padding:3px}.gr .bar{background:#dde8fb;font-size:16px;padding:3px}
table{width:100%;border-collapse:collapse;font-size:15px}
th{background:#d8e8fa;padding:5px;border:1px solid #9dbbe0;color:#12295a}
td{padding:3px 10px;border:1px solid #cfdcee;text-align:center}td:first-child{text-align:left}
tr.tot td{background:#d8e8fa;font-weight:700}
.sum{display:grid;grid-template-columns:repeat(3,1fr);align-items:center;background:#e8f2fc;padding:8px 0}
.sum div{text-align:center;border-left:1px solid #9dbbe0;font-size:15px}.sum div:first-child{border:0}
.sum b{display:block;font-size:24px;color:#12295a}
.cg3{display:grid;grid-template-columns:repeat(3,1fr)}.cg3 .c{padding:3px 6px;border:1px solid #cfdcee;background:#f6fbf4;text-align:center;font-size:13.5px;line-height:1.3}.cg3 .c span{display:block;color:#33415c}.cg3 .c b{display:block;font-size:14.5px}
.rm{background:#fff8dc;border:1.5px solid #e7d27a;border-radius:10px;padding:6px 14px;margin-top:6px;font-size:15px;min-height:44px}
.ft{display:grid;grid-template-columns:1fr 1.2fr 1fr;align-items:end;margin-top:auto;padding-top:8px;text-align:center;font-size:14px}
.ft .ln{border-top:1.5px solid #1b3a6b;padding-top:4px;margin:0 14px;font-weight:600}
.ft i{font-size:16px;color:#1b3a6b}
.pass{color:#1b6b2d!important}.fail{color:#b00020!important}
@media print{@page{size:A4;margin:0}body{background:#fff}.top,.tools,.nope{display:none!important}main{padding:0;max-width:none}.panel{border:0;padding:0}.wrap{overflow:visible}
html,body{margin:0;padding:0}.wrap{padding:0}#card{width:210mm;height:296mm;margin:0;border-radius:0;page-break-after:avoid;-webkit-print-color-adjust:exact;print-color-adjust:exact}}

.hd{align-items:stretch;border-bottom:2px solid #a3122a;padding-bottom:7px}
.hd img{width:150px;height:auto;align-self:stretch;object-fit:contain;object-position:left center;mix-blend-mode:normal}.hd .t{display:flex;flex-direction:column;align-items:center}.blk .row2{margin-top:auto}
.hd .a{text-decoration:underline;text-underline-offset:5px}
.row2{display:flex;align-items:center;justify-content:space-between;gap:12px;margin:8px 0 0}
.row2 .rc{margin:0;width:285px;flex-shrink:0}
.row2 .sess{font-weight:700;font-size:17px;line-height:1.35;text-align:center;color:#12295a}
.iw{position:relative;margin-top:30px}
.iw .lg{position:absolute;top:-17px;left:50%;transform:translateX(-50%);background:#fff;padding:2px 24px;border:2px solid #c8102e;border-radius:999px;box-shadow:0 0 0 3px #fff,0 0 0 4px #f3c5cb;font:700 18px 'Source Sans 3';letter-spacing:.3px;white-space:nowrap;z-index:1;color:#a3122a}
.iw .box{margin-top:0;overflow:visible}
.info{padding:12px 4px 6px}
th{font-size:13.5px;line-height:1.2}
.th2{font-style:italic;font-weight:700}#sName,#sTitle{text-transform:uppercase}.blk{display:flex;flex-direction:column;width:max-content;min-width:470px;flex:1}.blk h3{white-space:nowrap;text-align:center}.blk .a{align-self:center}input[type=file]{padding:6px}
</style></head><body>
<div class="top"><b>Red Rose Public School</b><button id="tNew" class="on" type="button">New marksheet</button><button id="tSaved" type="button">Saved marksheets</button><button id="tSet" type="button">School settings</button></div>
<main>
<section id="pForm" class="panel">
 <h1 id="fTitle">New marksheet</h1>
 <p class="s">Student ki detail bharein, phir "Generate marksheet" dabayein. Marksheet agle page par khulegi aur apne aap save ho jayegi.</p>
 <div class="g2"><div><label>Academic session</label><input id="session" value="2026 – 2027"></div><div><label>Examination</label><input id="exam" value="Half-Yearly Examination"></div></div>
 <h2>Student details</h2>
 <label>Student's name *</label><input id="name">
 <div class="g3">
  <div><label>Roll no.</label><input id="roll"></div>
  <div><label>Class</label><input id="cls" placeholder="e.g. 3"></div>
  <div><label>Section</label><input id="section" placeholder="e.g. A"></div>
  <div><label>Days present</label><input id="pres" type="number" min="0"></div>
  <div><label>Total working days</label><input id="work" type="number" min="0" value="100"></div>
 </div>
 <h2>Marks</h2>
 <div class="sub"><label>Subject</label><label>Semester (80)</label><label>Internal (20)</label></div>
 <div id="subs"></div>
 <div class="btns" style="margin-top:6px"><button class="o" id="addSub" type="button">Add subject</button></div>
 <h2>Co-scholastic grades</h2><div id="cos"></div>
 <h2>Teacher's remarks</h2><textarea id="rem" rows="2">A bright and hardworking student. Keep it up!</textarea>
 <div class="btns"><button id="gen" type="button">Generate marksheet</button><button class="o" id="reset" type="button">Clear form</button><span id="ferr" class="err" role="alert"></span></div>
</section>
<section id="pCard" class="hide">
 <div class="btns tools" style="margin:0 0 4px"><button class="o" id="bEdit" type="button">Edit details</button><button class="o" id="bSet" type="button">Edit school info &amp; logo</button><button id="bPrint" type="button">Print / Save as PDF</button><button class="o" id="bPng" type="button">Download image</button><button class="o" id="bNew" type="button">New student</button><span id="saveMsg" class="s" style="margin:0"></span></div>
 <div class="wrap"><div id="card">
  <div class="hd"><img id="sLogo" src="data:image/png;base64," alt="School logo"><div class="t"><div class="blk"><h3 id="sName">RED ROSE PUBLIC SCHOOL</h3><div class="a" id="sAddr">Neemdangal, Mugma</div><div class="row2"><div class="rc" id="sTitle">PROGRESS CARD</div><div class="sess">Academic Session :<br><span id="vSession"></span></div></div></div></div></div>
  <div class="iw"><div class="lg" id="vExam"></div><div class="box info">
   <div><div class="r"><span>Student's Name</span>:<b id="vName"></b></div><div class="r"><span>Roll No.</span>:<b id="vRoll"></b></div><div class="r"><span>Class</span>:<b id="vCls"></b></div></div>
   <div><div class="r"><span>Section</span>:<b id="vSec"></b></div><div class="r"><span>Attendance</span>:<b id="vAtt"></b></div><div class="r"><span>Result</span>:<b id="vRes"></b></div></div>
  </div></div>
  <div class="box sc"><div class="bar">SCHOLASTIC PERFORMANCE</div><table><thead><tr><th style="width:27%">Subject</th><th class="th2">Semester<br>(80)</th><th class="th2">Internal Assessment<br>(20)</th><th>Full Marks</th><th>Obtained Marks</th><th>Grade</th></tr></thead><tbody id="vRows"></tbody></table></div>
  <div class="box sum"><div>Percentage<b id="vPct"></b></div><div>Grade<b id="vGr"></b></div><div>Result<b id="vRes2"></b></div></div>
  <div class="box gr"><div class="bar">SUBJECT-WISE PERFORMANCE GRAPH (% of full marks)</div><div id="vChart"></div></div>
  <div class="box co"><div class="bar">CO-SCHOLASTIC ACTIVITIES</div><div class="cg3" id="vCo"></div></div>
  <div class="rm"><b>Teacher's Remarks :</b><div id="vRem" style="margin-top:3px"></div></div>
  <div class="ft"><div class="ln">Class Teacher</div><i id="sMotto">Small Steps... Big Dreams...</i><div class="ln">Principal</div></div>
 </div></div>
</section>
<section id="pSet" class="panel hide">
 <h1>School settings</h1>
 <p class="s">School ka naam, address aur logo yahan badlein. Badlav har marksheet mein dikhega.</p>
 <label>School name</label><input id="eName">
 <label>Address</label><input id="eAddr">
 <div class="g2"><div><label>Card title</label><input id="eTitle"></div><div><label>Footer line</label><input id="eMotto"></div></div>
 <h2>Logo</h2>
 <div style="display:flex;gap:16px;align-items:center;flex-wrap:wrap"><img id="ePrev" alt="Logo preview" style="width:120px;height:112px;object-fit:contain;background:#fff;border:1px solid rgba(128,128,128,.3);border-radius:8px;padding:4px"><div style="flex:1;min-width:220px"><label>Nayi logo chunein (PNG / JPG)</label><input id="eFile" type="file" accept="image/*"><div class="btns" style="margin-top:8px"><button class="o" id="eRst" type="button">Original logo wapas lagayein</button></div></div></div>
 <div class="btns"><button id="eSave" type="button">Save</button><button class="o" id="eBack" type="button">Back</button><span id="eMsg" class="s" style="margin:0"></span></div>
</section>
<section id="pSaved" class="panel hide">
 <h1>Saved marksheets</h1>
 <p class="s">Naam, roll no., class ya section se search karein.</p>
 <input id="q" type="search" placeholder="Search student…" aria-label="Search saved marksheets">
 <p id="stat" class="s" style="margin-top:8px"></p>
 <div id="list"></div>
</section>
</main>
<script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
<script>
var $=function(i){return document.getElementById(i)};
var SUBJ=["English","Hindi","Mathematics","Science","Social Science","Computer"];
var CO=[["Discipline","Good"],["Handwriting","Good"],["Art & Craft","Good"],["Sports & Games","Good"],["Personal & Social Behaviour","Good"]];
var GR=["Excellent","Very Good","Good","Satisfactory","Needs Improvement"];
var FIELDS=["session","exam","name","roll","cls","section","pres","work","rem"];
var cur=null,editId=null,all=[],db=null;
function esc(s){return String(s==null?"":s).replace(/[&<>"]/g,function(c){return{"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"}[c]})}
function grade(p){return p>=85?"A+":p>=80?"A":p>=75?"B+":p>=70?"B":p>=60?"C+":p>=50?"C":p>=33?"D":"E"}
function norm(r){r.subjects=r.subjects.map(function(x){var s=x.s!=null?x.s:x.m,i=x.i||0;return{n:x.n,s:s,i:i,f:x.f||100,m:s+i}});return r}
var store={
 list:function(){
  if(db)return db.collection("marksheets").get().then(function(s){return s.docs.map(function(d){return d.data()})});
  try{return Promise.resolve(JSON.parse(localStorage.getItem("rrps_marksheets")||"[]"))}catch(e){return Promise.resolve([])}},
 save:function(r){
  if(db)return db.collection("marksheets").doc(r.id).set(r);
  try{var a=JSON.parse(localStorage.getItem("rrps_marksheets")||"[]").filter(function(x){return x.id!==r.id});a.push(r);localStorage.setItem("rrps_marksheets",JSON.stringify(a));return Promise.resolve()}catch(e){return Promise.reject(e)}},
 del:function(id){
  if(db)return db.collection("marksheets").doc(id).delete();
  try{var a=JSON.parse(localStorage.getItem("rrps_marksheets")||"[]").filter(function(x){return x.id!==id});localStorage.setItem("rrps_marksheets",JSON.stringify(a));return Promise.resolve()}catch(e){return Promise.reject(e)}}
};
if(window.claude&&claude.use){claude.use("db").then(function(d){db=d;loadSet();if(!$("pSaved").classList.contains("hide"))loadSaved()},function(){})}
function addSub(n,s,i){var d=document.createElement("div");d.className="sub";
 d.innerHTML='<input class="sn" value="'+esc(n)+'" aria-label="Subject"><input class="ss" type="number" min="0" max="80" value="'+esc(s)+'" aria-label="Semester marks out of 80"><input class="si" type="number" min="0" max="20" value="'+esc(i)+'" aria-label="Internal assessment out of 20">';$("subs").appendChild(d)}
function addCo(n,g){var d=document.createElement("div");d.className="g2";d.style.marginBottom="5px";
 d.innerHTML='<input class="cn" value="'+esc(n)+'" aria-label="Area"><select class="cg" aria-label="Grade">'+GR.map(function(x){return'<option'+(x==g?" selected":"")+'>'+x+'</option>'}).join("")+'</select>';$("cos").appendChild(d)}
function fillForm(r){
 var D={session:"2026 – 2027",exam:"Half-Yearly Examination",work:100,rem:"A bright and hardworking student. Keep it up!"};
 FIELDS.forEach(function(k){$(k).value=r&&r[k]!=null?r[k]:(D[k]!=null?D[k]:"")});
 $("subs").innerHTML="";(r?r.subjects.map(function(s){return[s.n,s.s,s.i]}):SUBJ.map(function(n){return[n,"",""]})).forEach(function(s){addSub(s[0],s[1],s[2])});
 $("cos").innerHTML="";(r?r.co.map(function(c){return[c.n,c.g]}):CO).forEach(function(c){addCo(c[0],c[1])});
 $("fTitle").textContent=r?"Edit marksheet":"New marksheet";$("ferr").textContent=""}
function readForm(){
 var r={},bad="";FIELDS.forEach(function(k){r[k]=$(k).value.trim()});
 r.subjects=[];document.querySelectorAll("#subs .sub").forEach(function(e){var n=e.querySelector(".sn").value.trim();if(!n)return;
  var s=+e.querySelector(".ss").value||0,i=+e.querySelector(".si").value||0;
  if(s>80||i>20||s<0||i<0)bad=n+": Semester 80 aur Internal 20 se zyada nahi ho sakte.";
  r.subjects.push({n:n,s:s,i:i,f:100,m:s+i})});
 r.bad=bad;
 r.co=[];document.querySelectorAll("#cos .g2").forEach(function(e){r.co.push({n:e.querySelector(".cn").value.trim(),g:e.querySelector(".cg").value})});
 var T=0,O=0,S=0,I=0;r.subjects.forEach(function(s){T+=s.f;O+=s.m;S+=s.s;I+=s.i});
 r.total=T;r.obtained=O;r.semTotal=S;r.intTotal=I;r.pct=T?+(O/T*100).toFixed(2):0;r.result=r.pct>=33?"PASS":"FAIL";
 return r}
function chart(subs){
 var W=700,H=135,L=34,B=30,T=14,n=subs.length,pw=W-L-8,ph=H-B-T,bw=Math.min(54,pw/n*.55),s="";
 [0,50,100].forEach(function(v){var y=T+ph-ph*v/100;s+='<line x1="'+L+'" x2="'+(W-8)+'" y1="'+y+'" y2="'+y+'" stroke="#c9d6ea" stroke-dasharray="3 3"/><text x="'+(L-5)+'" y="'+(y+4)+'" font-size="11" text-anchor="end" fill="#455">'+v+'</text>'});
 var pts=[];
 subs.forEach(function(x,i){var p=x.f?Math.min(100,x.m/x.f*100):0,cx=L+pw/n*(i+.5),h=ph*p/100,y=T+ph-h;pts.push(cx+","+y);
  s+='<rect x="'+(cx-bw/2)+'" y="'+y+'" width="'+bw+'" height="'+h+'" rx="3" fill="'+(p<33?"#d9534f":"#4f86c6")+'"/><text x="'+cx+'" y="'+(y-12)+'" font-size="11.5" font-weight="700" text-anchor="middle" fill="#12295a">'+x.m+'</text><text x="'+cx+'" y="'+(H-14)+'" font-size="11.5" text-anchor="middle" fill="#12295a">'+esc(x.n.length>11?x.n.slice(0,10)+"…":x.n)+'</text>'});
 s+='<polyline points="'+pts.join(" ")+'" fill="none" stroke="#a3122a" stroke-width="2"/>'+pts.map(function(p){var q=p.split(",");return'<circle cx="'+q[0]+'" cy="'+q[1]+'" r="3.5" fill="#a3122a"/>'}).join("");
 return'<svg viewBox="0 0 '+W+' '+H+'" width="100%" role="img" aria-label="Marks per subject" style="display:block;background:#f7fbff">'+s+'</svg>'}
function showCard(r){
 norm(r);
 var m={session:"vSession",exam:"vExam",name:"vName",roll:"vRoll",cls:"vCls",section:"vSec",rem:"vRem"};
 for(var k in m)$(m[k]).textContent=r[k]||"";
 $("vAtt").textContent=(r.pres||0)+" / "+(r.work||0)+" Days";
 var S=0,I=0;r.subjects.forEach(function(s){S+=s.s;I+=s.i});
 $("vRows").innerHTML=r.subjects.map(function(s){return"<tr><td>"+esc(s.n)+"</td><td>"+s.s+"</td><td>"+s.i+"</td><td>"+s.f+"</td><td>"+s.m+"</td><td><b>"+grade(s.f?s.m/s.f*100:0)+"</b></td></tr>"}).join("")+'<tr class="tot"><td style="text-align:center">Total</td><td>'+S+"</td><td>"+I+"</td><td>"+r.total+"</td><td>"+r.obtained+"</td><td>-</td></tr>";
 $("vPct").textContent=r.pct.toFixed(2)+"%";$("vGr").textContent=grade(r.pct);
 [$("vRes"),$("vRes2")].forEach(function(e){e.textContent=r.result;e.className=r.result=="PASS"?"pass":"fail"});
 $("vChart").innerHTML=chart(r.subjects);
 $("vCo").innerHTML=r.co.map(function(c){return'<div class="c"><span>'+esc(c.n)+"</span><b>"+esc(c.g)+"</b></div>"}).join("")}
function go(p){["pForm","pCard","pSaved","pSet"].forEach(function(i){$(i).classList.toggle("hide",i!=p)});
 $("tNew").classList.toggle("on",p=="pForm"||p=="pCard");$("tSaved").classList.toggle("on",p=="pSaved");$("tSet").classList.toggle("on",p=="pSet");window.scrollTo(0,0);if(p=="pSaved")loadSaved();if(p=="pCard")fitName()}
function mkId(r){return[r.name,r.cls,r.section,r.roll,r.exam,r.session].join("_").replace(/[^A-Za-z0-9]+/g,"_").slice(0,150)||("s_"+Date.now())}
$("gen").onclick=function(){
 var r=readForm();
 if(!r.name){$("ferr").textContent="Student ka naam zaroori hai.";$("name").focus();return}
 if(!r.subjects.length){$("ferr").textContent="Kam se kam ek subject jodein.";return}
 if(r.bad){$("ferr").textContent=r.bad;return}
 delete r.bad;r.id=editId||mkId(r);r.savedAt=new Date().toISOString();cur=r;editId=r.id;
 showCard(r);go("pCard");$("saveMsg").textContent="Saving…";
